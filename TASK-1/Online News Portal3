                <img src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=500" alt="World">
                <div class="content">
                    <h3>World News Updates</h3>
                    <p>Important international events and global developments.</p>
                    <p class="author">By John David</p>
                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1529107386315-e1a2ed48a620?w=500" alt="Government">
                <div class="content">
                    <h3>Global Politics</h3>
                    <p>Latest updates on international relations.</p>
                    <p class="author">By Anil Kumar</p>
                </div>
            </div>
        </div>
    </section>

    <section id="sports">
        <h2>Sports News</h2>
        <div class="container">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?w=500" alt="Cricket">
                <div class="content">
                    <h3>Cricket Updates</h3>
                    <p>Latest cricket matches, scores and tournament news.</p>
                    <p class="author">By Sports Desk</p>
                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=500" alt="Football">
                <div class="content">
                    <h3>Football News</h3>
                    <p>Get updates about football matches and players.</p>
                    <p class="author">By Arjun Reddy</p>
                </div>
            </div>
        </div>
    </section>

    <section class="technology" id="technology">
        <h2>Technology News</h2>
        <div class="container">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=500" alt="Technology">
                <div class="content">
                    <h3>Latest Technology</h3>
                    <p>Explore new inventions and modern technologies.</p>
                    <p class="author">By Tech Desk</p>
                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=500" alt="AI">
                <div class="content">
                    <h3>Artificial Intelligence</h3>
                    <p>Discover the latest developments in AI technology.</p>
                    <p class="author">By Suresh Kumar</p>
                </div>
            </div>
        </div>
    </section>

    <section class="business" id="business">
        <h2>Business News</h2>
        <div class="container">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=500" alt="Business">
                <div class="content">
                    <h3>Business Updates</h3>
                    <p>Latest business trends and company developments.</p>
                    <p class="author">By Business Desk</p>
                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=500" alt="Finance">
                <div class="content">
                    <h3>Market News</h3>
                    <p>Updates about financial markets and the economy.</p>
                    <p class="author">By Finance Desk</p>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <h2>DAILY NEWS</h2>
        <p>Stay Informed | Stay Updated</p>
        <p>© 2026 Daily News Portal</p>
    </footer>

</body>
</html>
