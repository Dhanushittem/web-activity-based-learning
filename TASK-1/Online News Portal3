
<!DOCTYPE html>
<html>
<head>
    <title>Online News Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            color: #333;
        }

        header {
            background: #172b4d;
            color: white;
            padding: 25px;
            text-align: center;
        }

        header h1 {
            font-size: 32px;
        }

        nav {
            background: #e63946;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
            font-weight: bold;
        }

        .breaking {
            background: #fff0f0;
            padding: 15px;
            color: red;
            font-weight: bold;
        }

        .featured {
            padding: 30px;
            background: white;
        }

        .featured img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            border-radius: 10px;
        }

        .featured h2 {
            margin: 15px 0;
            color: #172b4d;
        }

        section {
            padding: 30px;
        }

        section h2 {
            color: #172b4d;
            margin-bottom: 20px;
            border-bottom: 3px solid #e63946;
            padding-bottom: 10px;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .card {
            background: white;
            width: 30%;
            min-width: 250px;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 3px 8px #ccc;
        }

        .card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .content {
            padding: 15px;
        }

        .content h3 {
            color: #172b4d;
            margin-bottom: 10px;
        }

        .content p {
            line-height: 1.5;
        }

        .author {
            color: #e63946;
            margin-top: 12px;
            font-size: 13px;
        }

        .business {
            background: #e8edf5;
        }

        .technology {
            background: white;
        }

        footer {
            background: #172b4d;
            color: white;
            text-align: center;
            padding: 25px;
        }

        @media (max-width: 700px) {
            nav a {
                display: inline-block;
                margin: 8px;
            }

            .card {
                width: 100%;
            }

            .featured img {
                height: 200px;
            }

            section {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>DAILY NEWS</h1>
        <p>Your World, Your News</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#national">National</a>
        <a href="#international">International</a>
        <a href="#sports">Sports</a>
        <a href="#technology">Technology</a>
        <a href="#business">Business</a>
    </nav>

    <div class="breaking">
        BREAKING NEWS: Get the latest news and updates from around the world!
    </div>

    <div class="featured" id="home">
        <h2>Featured Story</h2>
        <img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1000" alt="News">
        <h2>Latest Headlines From Around The World</h2>
        <p>Stay updated with the latest national and international news.</p>
        <p class="author">By News Desk | October 30, 2026</p>
    </div>

    <section id="national">
        <h2>National News</h2>
        <div class="container">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1524492412937-b28074a5d7da?w=500" alt="India">
                <div class="content">
                    <h3>India Development News</h3>
                    <p>Latest updates about development and important events in India.</p>
                    <p class="author">By Rahul Kumar</p>
                </div>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1595658658481-d53d3f999875?w=500" alt="City">
                <div class="content">
                    <h3>Education Updates</h3>
                    <p>New developments and updates in the education sector.</p>
                    <p class="author">By Priya Sharma</p>
                </div>
            </div>
        </div>
    </section>

    <section id="international">
