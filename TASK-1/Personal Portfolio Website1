
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dhanush | Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fc;
            color: #222;
        }

        header {
            background: #123d6b;
            color: white;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        header h2 {
            color: #ffd166;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 18px;
            transition: 0.3s;
        }

        nav a:hover {
            color: #ffd166;
        }

        section {
            padding: 65px 8%;
            scroll-margin-top: 65px;
        }

        .hero {
            min-height: 80vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: linear-gradient(135deg, #123d6b, #2876a8);
            color: white;
            animation: fadeIn 1.2s;
        }

        .profile {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            border: 4px solid #ffd166;
            background: #e3edfa;
            color: #123d6b;
            display: grid;
            place-items: center;
            font-size: 45px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 42px;
            margin-bottom: 12px;
        }

        .hero p {
            margin: 8px;
            line-height: 1.6;
        }

        .btn {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 22px;
            background: #ffd166;
            color: #123d6b;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-4px);
            background: white;
        }

        h2.title {
            text-align: center;
            color: #123d6b;
            margin-bottom: 30px;
        }

        .card-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 12px #00000012;
            transition: 0.3s;
            animation: fadeIn 1s;
        }

        .card:hover {
            transform: translateY(-7px);
            box-shadow: 0 8px 20px #123d6b25;
        }

        .card h3 {
            color: #2876a8;
            margin-bottom: 12px;
        }

        .card p, .about-text {
            line-height: 1.7;
        }

        .skills span {
            display: inline-block;
            background: #dceafa;
            color: #123d6b;
            padding: 10px 16px;
            margin: 6px;
            border-radius: 20px;
            transition: 0.3s;
        }

        .skills span:hover {
            background: #123d6b;
            color: white;
            transform: scale(1.08);
        }

        .contact {
            text-align: center;
            background: #e5eef9;
        }

        .contact p {
            margin: 14px;
        }

        footer {
            text-align: center;
            padding: 20px;
            background: #123d6b;
            color: white;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 700px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            nav {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 12px;
            }

            nav a {
                margin: 0;
                font-size: 14px;
            }

            .hero h1 {
                font-size: 30px;
            }

            section {
                padding: 45px 6%;
            }
        }
    </style>
</head>

